	<packaging>pom</packaging>
	<name>JasperReports Library Artifacts</name>
	<description>Free Java Reporting Library</description>
	<url>https://github.com/audichuang/jasperreports</url>
	<organization>
		<name>audichuang</name>
		<url>https://github.com/audichuang</url>
