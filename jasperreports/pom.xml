<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.audichuang</groupId>
		<artifactId>jasperreports-common</artifactId>
		<version>${revision}</version>
		<relativePath>./pom-common.xml</relativePath>
	</parent>
	<groupId>io.github.audichuang</groupId>
	<artifactId>jasperreports</artifactId>
	<packaging>jar</packaging>
	<name>JasperReports Library (CVE-2026-6009 backport)</name>
	<description>Unofficial rebuild of JasperReports Library 6.21.5 with the deserialization
		class filter from upstream 7.0.4/7.0.7 backported to fix CVE-2026-6009 (CWE-502).
		Java package names, public API and rendered output are unchanged from 6.21.5, so
		existing .jasper and .jrxml files work without modification. Not affiliated with,
		nor endorsed by, Jaspersoft or Cloud Software Group. See the project URL for the
		full source and the verification suite.</description>
	<url>https://github.com/audichuang/jasperreports</url>
	<scm>
		<connection>${scmConnection}</connection>
		<tag>${revision}</tag>
		<url>${scmUrl}</url>
	</scm>
	<properties>
		<maven.test.skip>true</maven.test.skip>
		<skipInstall>false</skipInstall>
		<skipDeploy>false</skipDeploy>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.22.1</version>
				<configuration>
					<systemPropertyVariables>
						<xmlOutputDir>${project.build.directory}/surefire</xmlOutputDir>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.0.1</version>
				<configuration>
					<quiet>true</quiet>
					<doclint>none</doclint>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>clirr-maven-plugin</artifactId>
				<version>2.8</version>
				<configuration>
					<comparisonVersion>6.21.4</comparisonVersion>
					<ignoredDifferencesFile>${basedir}/clirr-ignore.xml</ignoredDifferencesFile>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
